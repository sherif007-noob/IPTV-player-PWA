# Server & AI configuration
GEMINI_API_KEY=

# IPTV Provider Proxy Configuration (Optional custom upstream headers)
PROVIDER_USER_AGENT=IPTVSmartersPlayer/3.0.0
PROVIDER_REFERER=
PROVIDER_ORIGIN=

# Optional comma-separated whitelist of allowed IPTV provider hostnames (e.g. mar10.sbs,example-iptv.com)
ALLOWED_IPTV_HOSTS=

# Optional: forward client IP identity headers to the IPTV provider.
# Leave disabled unless this app is behind a trusted reverse proxy and your provider requires it.
FORWARD_CLIENT_IP_HEADERS=false
